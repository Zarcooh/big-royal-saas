# Copia este archivo como `.env` y rellena los valores reales.
# Los valores de Supabase te los pasa el responsable del proyecto por un
# canal privado (NO los subas al repositorio: .env está en .gitignore).

# URL del proyecto Supabase (Project Settings -> API -> Project URL)
SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Clave publicable / anon (Project Settings -> API -> anon public).
# Es la unica clave que la app necesita ademas de la URL.
SUPABASE_ANON_KEY=tu-clave-anon-aqui

# NO es necesaria para correr la app: solo se carga pero no se usa en el runtime.
# Es un SECRETO que se salta las politicas RLS; no la compartas en canales
# publicos ni la subas al repo. Puedes dejar esta linea fuera de tu .env.
# SUPABASE_SERVICE_ROLE_KEY=tu-clave-service-role-aqui
